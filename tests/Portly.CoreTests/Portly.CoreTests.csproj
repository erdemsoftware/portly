<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine checks that run on Windows, macOS and Linux (.NET 10), in CI on every v2 push. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Portly.CoreTests</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\src\Portly\lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Portly.Core\Portly.Core.csproj" />
    <!-- Avalonia-free sources of the desktop app: notifications, start-up routing, shutdown handling -->
    <Compile Include="..\..\src\Portly.Desktop\Notify.cs;..\..\src\Portly.Desktop\StartupRoute.cs;..\..\src\Portly.Desktop\ShutdownGuard.cs" Link="Desktop\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
