<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colors, font sizes and the input colors come from Theme.Apply (application resources). Sizes are those of the Windows app (WinForms Ui.Font 9 pt = 12 px ...). -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
  </Style>

  <!-- text -->
  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontFamily" Value="{DynamicResource SemiboldFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource SemiboldWeight}" />
  </Style>
  <Style Selector=":is(TextBlock).brand">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBrand}" />
    <Setter Property="FontFamily" Value="{DynamicResource SemiboldFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource SemiboldWeight}" />
  </Style>
  <Style Selector=":is(TextBlock).subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
    <Setter Property="FontFamily" Value="{DynamicResource SemiboldFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource SemiboldWeight}" />
  </Style>
  <Style Selector=":is(TextBlock).bold">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBold}" />
    <Setter Property="FontFamily" Value="{DynamicResource SemiboldFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource SemiboldWeight}" />
  </Style>
  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector=":is(TextBlock).small">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>
  <Style Selector=":is(TextBlock).section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
  </Style>

  <!-- cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.console">
    <Setter Property="Background" Value="{DynamicResource ConsoleBg}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- buttons (ModernButton of the Windows app): default = outlined card, .primary = blue, .danger = red, .ghost = no frame, .nav = sidebar, .tile = quick access, .link = text link -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledLine}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Red}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RedHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button:disabled.primary /template/ ContentPresenter#PART_ContentPresenter, Button:disabled.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledFill}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
  </Style>

  <Style Selector="Button.bold">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBold}" />
    <Setter Property="FontFamily" Value="{DynamicResource SemiboldFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource SemiboldWeight}" />
  </Style>
  <Style Selector="Button.picked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.picked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.green">
    <Setter Property="Background" Value="{DynamicResource Green}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.green:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.green:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GreenHover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.ghost, Button.nav, Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector="Button.nav.side">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Width" Value="198" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,0,8,0" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource SidebarActive}" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveText}" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarActive}" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveText}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
  </Style>

  <Style Selector="Button.tile">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="Height" Value="76" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!-- inputs: flat with a thin line, accent when focused (colors in Theme.ApplyInputs) -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- on / off switch of a service card (ToggleSwitch of the Windows app: 44 x 24, green when on, grey when off, orange while starting / stopping) -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Track" Margin="1,1,2,2" CornerRadius="10.5" Background="{DynamicResource SwitchOff}" BorderBrush="{DynamicResource Accent}" />
          <Grid Name="PART_MovingKnobs" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0">
            <Grid Name="PART_SwitchKnob"><Ellipse Fill="White" /></Grid>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Green}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Grid#PART_MovingKnobs">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,4,5,0" />
  </Style>
  <Style Selector="ToggleSwitch.busy /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Orange}" />
  </Style>
  <Style Selector="ToggleSwitch:disabled /template/ Border#Track">
    <Setter Property="Opacity" Value="0.43" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#Track">
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- menus follow the palette -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
