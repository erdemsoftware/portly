<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colors come from Theme.Apply (application resources named like the Palette fields). -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- text -->
  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=":is(TextBlock).subtitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).bold">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector=":is(TextBlock).small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector=":is(TextBlock).section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
  </Style>

  <!-- cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.console">
    <Setter Property="Background" Value="{DynamicResource ConsoleBg}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- buttons: default = outlined card, .primary = blue, .ghost = no frame, .danger = red text, .nav = sidebar, .link = text link -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>

  <Style Selector="Button.ghost, Button.nav, Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource SidebarActive}" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarActive}" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveText}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
  </Style>

  <Style Selector="Button.tile">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinWidth" Value="128" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- menus follow the palette -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
