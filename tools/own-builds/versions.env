APR_VERSION=1.7.6
APR_SHA256=49030d92d2575da735791b496dc322f3ce5cff9494779ba8cc28c7f46c5deb32
APR_UTIL_VERSION=1.6.6
APR_UTIL_SHA256=aa77dd25f036731b7246abbfbebe6cc813b42799b62c874bc82bd4e1f90f2918

MEMCACHED_VERSION=1.6.45
MEMCACHED_SHA256=d362c64e6d8d5287153501eabf7c85b4a761432fbf53f5d7b085d0bb1653c1dd
LIBEVENT_VERSION=2.1.13
LIBEVENT_SHA256=f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c

# OpenSSL 3.5 is the long-term support line (security fixes until April 2030)
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
PCRE2_VERSION=10.49
PCRE2_SHA256=929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae
ZLIB_VERSION=1.3.2
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
EXPAT_VERSION=2.10.0
EXPAT_SHA256=c624ba2998fc65df1163a49641ff3f9ab73138b11641d92c86bee0fb01b1bc7f
NGHTTP2_VERSION=1.71.0
NGHTTP2_SHA256=c0f55121d88650e4b9227aec28cebaf664d2417ca60fe70be0f8d38829f52116

# static-php-cli (spc): builds php-fpm and php-cli, and Xdebug as a loadable extension
SPC_VERSION=2.8.5
SPC_SHA256_linux_x64=523ba4279c54c7a377156c0dd3a36adf92ee64b01e9a7f5e9e2ec084b8e458e5
SPC_SHA256_linux_arm64=675a3840dcdc4ed041fe20eaa54310ce019a9984c1c03951df9ec66df5795213
SPC_SHA256_macos_x64=e8b798048f62ca4960764196543b60ae703f7174aa418824cf542aeec1d2cd6a
SPC_SHA256_macos_arm64=acf2f25d56d0cbf8e65aa82e5054fef555f7be7c5c38046c6e0819f266d83225

# Xdebug: the latest stable release (spc would pick the 3.6 alpha otherwise)
XDEBUG_VERSION=3.5.3
XDEBUG_SHA256=f073de91bea046106abf4d6071c963ea71e58571df6ce58948ceca89d121cb2d

# PHP lines to build (the newest patch release of each is taken)
PHP_LINES="8.5 8.4"

# Same extensions as the static-php "bulk" builds Portly uses today, plus pdo_sqlite / pdo_pgsql.
# Left out: swoole (+ hooks), a coroutine server that does not run together with Xdebug.
PHP_EXTENSIONS_FULL="apcu,bcmath,bz2,calendar,ctype,curl,dba,dom,event,exif,fileinfo,filter,ftp,gd,gmp,iconv,imagick,imap,intl,mbregex,mbstring,mysqli,mysqlnd,opcache,openssl,opentelemetry,pcntl,pdo,pdo_mysql,pdo_pgsql,pdo_sqlite,pgsql,phar,posix,protobuf,readline,redis,session,shmop,simplexml,soap,sockets,sodium,sqlite3,sysvmsg,sysvsem,sysvshm,tokenizer,xml,xmlreader,xmlwriter,xsl,zip,zlib"
# Small set for trying the build chain quickly (workflow_dispatch "quick")
PHP_EXTENSIONS_QUICK="ctype,curl,dom,fileinfo,filter,mbstring,mysqlnd,mysqli,opcache,openssl,pdo,pdo_mysql,phar,posix,session,simplexml,tokenizer,xml,xmlreader,xmlwriter,zlib"
